# FIND EVIL environment — copy to /opt/findevil/etc/.env and edit in place.
#
# `findevil.config.settings.AppSettings` loads this file via pydantic-settings
# with the `FINDEVIL_` prefix and double-underscore nested delimiter. See
# src/findevil/config/settings.py for the authoritative field list.

# ─── identity ───────────────────────────────────────────────────────────────
FINDEVIL_HOST_ID=sift-p620-01

# ─── transport ──────────────────────────────────────────────────────────────
FINDEVIL_TRANSPORT__ZMQ_IPC_DIR=/opt/findevil/run/zmq
FINDEVIL_TRANSPORT__VALKEY_SOCK=/opt/findevil/run/valkey.sock
FINDEVIL_TRANSPORT__VALKEY_HOST=127.0.0.1
FINDEVIL_TRANSPORT__VALKEY_PORT=6379
FINDEVIL_TRANSPORT__NATS_URL=nats://127.0.0.1:4222
FINDEVIL_TRANSPORT__NATS_JSDOMAIN=findevil
FINDEVIL_TRANSPORT__NATS_USER=writer
FINDEVIL_TRANSPORT__NATS_PASSWORD=change-me

# ─── ledger + CACAO keys ────────────────────────────────────────────────────
# CACAO signing keys live under LEDGER in the schema (LedgerCfg.cacao_sk_path).
FINDEVIL_LEDGER__SQLITE_PATH=/opt/findevil/data/ledger/ledger.sqlite
FINDEVIL_LEDGER__ED25519_SK_PATH=/opt/findevil/etc/keys/ledger_ed25519.sk
FINDEVIL_LEDGER__ED25519_PK_PATH=/opt/findevil/etc/keys/ledger_ed25519.pk
FINDEVIL_LEDGER__CACAO_SK_PATH=/opt/findevil/etc/keys/cacao_ed25519.sk
FINDEVIL_LEDGER__CACAO_PK_PATH=/opt/findevil/etc/keys/cacao_ed25519.pk
FINDEVIL_LEDGER__REKOR_URL=https://rekor.sigstore.dev
FINDEVIL_LEDGER__ANCHOR_EVERY_N=256

# ─── swarm / fusion ─────────────────────────────────────────────────────────
FINDEVIL_SWARM__DECAY_RHO=0.05
FINDEVIL_SWARM__TICK_MS=10
FINDEVIL_SWARM__THETA_MITIGATE=0.80
FINDEVIL_SWARM__THETA_FINDING=0.50
FINDEVIL_SWARM__K_YAGER_LO=0.30
FINDEVIL_SWARM__K_YAGER_HI=0.70
FINDEVIL_SWARM__K_ESCALATE=0.70
FINDEVIL_SWARM__SENSOR_DIVERSITY_MIN=2

# ─── fractal ────────────────────────────────────────────────────────────────
FINDEVIL_FRACTAL__MAX_DEPTH=3
FINDEVIL_FRACTAL__MAX_WIDTH=16
FINDEVIL_FRACTAL__TTL_MS=2000
FINDEVIL_FRACTAL__PIVOT_BAR=0.50

# ─── inference ──────────────────────────────────────────────────────────────
# Profile A = llama-cpp-python OpenAI shim; B = vLLM; C = sglang.
# Both Profile A and B must honour response_format={"type":"json_object"}.
FINDEVIL_INFERENCE__PROFILE=A
FINDEVIL_INFERENCE__MODEL_PATH=/opt/findevil/data/models/Llama-3.2-3B-Instruct-Q4_K_M.gguf
FINDEVIL_INFERENCE__MODEL_NAME=llama-3.2-3b-instruct
FINDEVIL_INFERENCE__CTX=2048
FINDEVIL_INFERENCE__N_GPU_LAYERS=28
FINDEVIL_INFERENCE__LLAMACPP_HOST=127.0.0.1
FINDEVIL_INFERENCE__LLAMACPP_PORT=8080
FINDEVIL_INFERENCE__VLLM_HOST=127.0.0.1
FINDEVIL_INFERENCE__VLLM_PORT=8000

# ─── MCP blackboard ─────────────────────────────────────────────────────────
FINDEVIL_MCP__HOST=127.0.0.1
FINDEVIL_MCP__PORT=9310
FINDEVIL_MCP__PATH=/mcp

# ─── dashboard / TUI ────────────────────────────────────────────────────────
FINDEVIL_UI__HTTP_HOST=127.0.0.1
FINDEVIL_UI__HTTP_PORT=9400

# ─── observability ──────────────────────────────────────────────────────────
FINDEVIL_OBSERVABILITY__OTLP_ENDPOINT=127.0.0.1:4317
FINDEVIL_OBSERVABILITY__PROMETHEUS_PORT=8889
FINDEVIL_OBSERVABILITY__SERVICE_NAME=findevil
